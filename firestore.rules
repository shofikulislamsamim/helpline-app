rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // App Settings: readable by anyone, writable by admin
    match /appSettings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Policies: readable by all
    match /policies/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: readable by all
    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Professions and Skills: readable by all
    match /professions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles & credentials
    match /users/{userId} {
      // Private account record: never publicly readable.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Private profile: contains contact details, full address, and live location.
    match /userProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Public marketplace projection: only intentionally safe profile fields.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /userRoles/{userId} {
      // Authorization/capability data is private.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customCategoryRequests/{reqId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /adminUsers/{userId} {
      // Users may read only their own admin record; admins may read admin records.
      // Writes are restricted to an already-authorized admin.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Verification Requests (PII Isolation: strictly owner or admin)
    match /verificationRequests/{reqId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin() || (isOwner(resource.data.userId) && (resource.data.status in ['rejected', 'reverification_required']));
      allow delete: if isAdmin();
    }

    // Verification Audit Logs (Immutable security history, strictly Admin only)
    match /verificationAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Subscriptions and manual payment requests
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }
    match /paymentRequests/{payId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
    }

    // Marketplace collections
    match /serviceRequests/{id} {
      // Requests contain phone numbers, exact work addresses and other private job details.
      // Only the customer, assigned worker, or an admin may read them.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.workerId ||
        request.auth.uid == resource.data.creatorId ||
        isAdmin()
      );

      // A request must be created by its customer/creator.
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.customerId ||
        request.auth.uid == request.resource.data.creatorId
      );

      // Admins may manage requests. Normal users may only perform the specific
      // lifecycle action that belongs to their role.
      allow update: if isAdmin() ||
        (
          isAuthenticated() &&
          (
            // Worker sends a quote.
            (
              request.auth.uid == resource.data.workerId &&
              resource.data.status == 'REQUESTED' &&
              request.resource.data.status == 'QUOTED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'quote', 'quotedAt'])
            ) ||

            // Customer accepts a quote/request.
            (
              request.auth.uid == resource.data.customerId &&
              resource.data.status in ['REQUESTED', 'QUOTED'] &&
              request.resource.data.status == 'ACCEPTED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'agreedPrice', 'acceptedAt'])
            ) ||

            // Worker rejects a request.
            (
              request.auth.uid == resource.data.workerId &&
              resource.data.status == 'REQUESTED' &&
              request.resource.data.status == 'REJECTED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'rejectedAt'])
            ) ||

            // Worker advances the job state.
            (
              request.auth.uid == resource.data.workerId &&
              resource.data.status == 'ACCEPTED' &&
              request.resource.data.status == 'ON_THE_WAY' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            ) ||
            (
              request.auth.uid == resource.data.workerId &&
              resource.data.status in ['ACCEPTED', 'ON_THE_WAY'] &&
              request.resource.data.status == 'WORK_STARTED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
            ) ||
            (
              request.auth.uid == resource.data.workerId &&
              resource.data.status == 'WORK_STARTED' &&
              request.resource.data.status == 'WORK_COMPLETED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'serviceFeeBreakdown'])
            ) ||

            // Customer or worker may cancel before work starts.
            (
              (
                request.auth.uid == resource.data.customerId &&
                request.resource.data.cancelledBy == 'customer'
              ) ||
              (
                request.auth.uid == resource.data.workerId &&
                request.resource.data.cancelledBy == 'worker'
              )
            ) &&
            resource.data.status in ['REQUESTED', 'QUOTED', 'ACCEPTED', 'ON_THE_WAY'] &&
            request.resource.data.status == 'CANCELLED' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancellationReason', 'cancelledAt'])
          ) ||

          // Customer may submit rating fields only after completion.
          (
            request.auth.uid == resource.data.customerId &&
            resource.data.status == 'WORK_COMPLETED' &&
            request.resource.data.ratingSubmitted == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSubmitted', 'ratingValue', 'ratingComment'])
          ) ||

          // A participant may mark the request as disputed when filing a complaint.
          (
            request.auth.uid in [resource.data.customerId, resource.data.workerId] &&
            request.resource.data.status == 'DISPUTED' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'complaintId'])
          )
        );

      allow delete: if isAdmin() || (isAuthenticated() && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.creatorId
      ));
    }
    match /jobs/{id} {
      // Job listings are public marketplace data, but only the employer who owns
      // the listing (or an admin) may create/change/remove it.
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.employerId == request.auth.uid;

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.employerId == request.auth.uid &&
        request.resource.data.employerId == resource.data.employerId
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.employerId == request.auth.uid
      );
    }

    match /rides/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId || isAdmin());
      allow delete: if isAdmin();
    }

    match /deliveries/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.riderId || isAdmin());
      allow delete: if isAdmin();
    }

    match /productListings/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.sellerId || isAdmin());
    }

    // Conversations and Messages
    // A conversation must be tied to a real hire request and contain exactly
    // that request's customer + worker as participants.
    match /conversations/{id} {
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.participantIds || isAdmin());

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.hireRequestId is string &&
        exists(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)) &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasOnly([
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.customerId,
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.workerId
        ]) &&
        request.auth.uid in request.resource.data.participantIds
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.participantIds &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.hireRequestId == resource.data.hireRequestId &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTimestamp',
          'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    // A message is private to the participants of its conversation.
    // The sender must be one of the conversation participants.
    match /messages/{id} {
      allow read: if isAuthenticated() &&
        (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds
        );

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.conversationId is string &&
        exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == resource.data.senderId &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(resource.data.conversationId)
        ).data.participantIds
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == resource.data.senderId &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(resource.data.conversationId)
        ).data.participantIds
      );
    }

    // Reviews and Complaints
    match /reviews/{id} {
      allow read: if true;

      // One review per completed hire request. The document ID must equal
      // the hire request ID so a second review cannot be created for the same job.
      allow create: if isAuthenticated() &&
        id == request.resource.data.hireRequestId &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 1000 &&
        request.resource.data.revieweeId == get(
          /databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)
        ).data.workerId &&
        request.auth.uid == get(
          /databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)
        ).data.customerId &&
        get(
          /databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)
        ).data.status == 'WORK_COMPLETED';

      allow update, delete: if isAdmin();
    }
    match /complaints/{id} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.complainantId || isAdmin());

      // A complaint must be filed by the authenticated user about a hire request
      // in which they are actually a participant. Normal users cannot forge the
      // complainant, accused user, status, or admin-only fields.
      allow create: if isAuthenticated() &&
        request.resource.data.complainantId == request.auth.uid &&
        request.resource.data.hireRequestId is string &&
        exists(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)) &&
        request.auth.uid in [
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.customerId,
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.workerId
        ] &&
        request.resource.data.accusedUserId is string &&
        request.resource.data.accusedUserId != request.auth.uid &&
        request.resource.data.accusedUserId in [
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.customerId,
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.workerId
        ] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 200 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 2000 &&
        request.resource.data.createdAt is string &&
        !('adminNotes' in request.resource.data) &&
        !('resolvedAt' in request.resource.data);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{id} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.recipientId || isAdmin());
      // Only admins or a participant in the referenced hire request may create a notification.
      // The authenticated user must identify themselves as the sender.
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.hireRequestId is string &&
        exists(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)) &&
        request.auth.uid in [
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.customerId,
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.workerId
        ] &&
        request.resource.data.recipientId in [
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.customerId,
          get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.hireRequestId)).data.workerId
        ]
      );
      allow update: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
      allow delete: if isAdmin();
    }
  }
}
